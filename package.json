{
  "name": "@sligqoer/dsh-usage-stats",
  "description": "DSH Desktop 的用量统计、供应商配额、模型检测与控制插件。",
  "version": "0.2.5",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jockjrop/dsh-usage-stats.git"
  },
  "homepage": "https://github.com/Jockjrop/dsh-usage-stats#readme",
  "bugs": {
    "url": "https://github.com/Jockjrop/dsh-usage-stats/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "locale/",
    "screenshots/",
    "third_party/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:release": "node scripts/check-release.mjs",
    "lint": "node scripts/lint.mjs",
    "prepack": "npm run lint && npm run build && npm run check:release",
    "release": "node scripts/build-release.mjs",
    "publish:release": "node scripts/publish-npm.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "icon": "screenshots/icon.svg",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.1 <=0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dependencies": {
    "undici": "^8.12.3",
    "typescript": "5.9.3"
  }
}
