{
  "name": "@sligqoer/dsh-usage-stats",
  "description": "在 DSH Desktop 中看清每一次请求的 Token、费用与速度，按模型和供应商汇总花费，统一同一模型的不同名称，核对余额并比较模型实际表现。",
  "version": "0.2.6",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jockjrop/dsh-usage-stats.git"
  },
  "homepage": "https://github.com/Jockjrop/dsh-usage-stats#readme",
  "bugs": {
    "url": "https://github.com/Jockjrop/dsh-usage-stats/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "locale/",
    "screenshots/",
    "third_party/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:release": "node scripts/check-release.mjs",
    "lint": "node scripts/lint.mjs",
    "prepack": "npm run lint && npm run build && npm run check:release",
    "release": "node scripts/build-release.mjs",
    "publish:release": "node scripts/publish-npm.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "icon": "screenshots/icon.svg",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.1 <=0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dependencies": {
    "undici": "^6.21.3",
    "typescript": "5.9.3"
  }
}
