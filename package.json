{
  "name": "dsh-usage-stats",
  "description": "DSH Desktop token statistics with range filters, an incremental session corpus, and connected quota panels. Desktop profile only.",
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jockjrop/dsh-usage-stats.git"
  },
  "homepage": "https://github.com/Jockjrop/dsh-usage-stats#readme",
  "bugs": {
    "url": "https://github.com/Jockjrop/dsh-usage-stats/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/provider-quotas.js",
    "lib/quota-controls.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "screenshots/usage.png",
    "screenshots/quotas.png",
    "screenshots/controls.png",
    "screenshots/icon.svg",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dependencies": {},
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/consistency.test.mjs && node --test test/desktop.test.mjs test/usage.test.mjs test/client.test.mjs test/provider-quotas.test.mjs test/quota-controls.test.mjs test/privacy.test.mjs",
    "preview:heatmap": "node scripts/build-heatmap-preview.mjs"
  },
  "license": "Apache-2.0"
}
