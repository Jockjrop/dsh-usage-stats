{
  "name": "@sligqoer/dsh-usage-stats",
  "description": "DSH Desktop token and session statistics, resilient quota panels, and evidence-based model matching. Desktop profile only.",
  "version": "0.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jockjrop/dsh-usage-stats.git"
  },
  "homepage": "https://github.com/Jockjrop/dsh-usage-stats#readme",
  "bugs": {
    "url": "https://github.com/Jockjrop/dsh-usage-stats/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/provider-quotas.js",
    "lib/quota-controls.js",
    "lib/model-match.js",
    "lib/model-fingerprints.js",
    "lib/model-capabilities.js",
    "lib/model-test-history.js",
    "lib/fingerprints/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "screenshots/usage.png",
    "screenshots/quotas.png",
    "screenshots/controls.png",
    "screenshots/token-speed.png",
    "screenshots/match.png",
    "screenshots/icon.svg",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "release": "node scripts/build-release.mjs",
    "publish:release": "node scripts/publish-npm.mjs",
    "test": "node test/consistency.test.mjs && node --test test/desktop.test.mjs test/usage.test.mjs test/client.test.mjs test/client-locale-quota.test.mjs test/provider-quotas.test.mjs test/quota-controls.test.mjs test/model-match.test.mjs test/privacy.test.mjs",
    "preview:heatmap": "node scripts/build-heatmap-preview.mjs"
  },
  "license": "Apache-2.0"
}
